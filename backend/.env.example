# Copy this file to .env and fill in real values. .env is git-ignored.
#
# FLASK_ENV must be the exact string "development" to get dev settings
# (relaxed cookie security, the fallback SECRET_KEY below). Anything else,
# including leaving it unset, runs the hardened production config - so
# production deployments (e.g. Railway) should set FLASK_ENV=production
# explicitly rather than relying on that fallback.
FLASK_ENV=development
# Interactive debugger + auto-reload. Only meaningful locally - never set
# this to true in production, it lets visitors run arbitrary code.
FLASK_DEBUG=true
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
JWT_EXPIRES_MINUTES=480
# Sign-in throttling: failed attempts per username+IP before a temporary lockout
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=300

DB_HOST=localhost
DB_PORT=3306
DB_NAME=work_order_db
DB_USER=wo_app
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Optional: material photos (Cloudinary). From the Cloudinary console
# dashboard ("Product Environment Credentials"). Leave empty to disable uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Optional, EXPERIMENTAL: AI hint on material photos (Claude API key from
# console.anthropic.com). Leave empty to show photos without an AI hint.
ANTHROPIC_API_KEY=
# PHOTO_CHECK_MODEL=claude-opus-5-5
